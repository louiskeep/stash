# stash configuration (copy to .env; never commit .env)
STASH_DB_PATH=stash.db
STASH_EMBED_MODEL=all-MiniLM-L6-v2

# --- Web UI ---
# Leave STASH_WEB_PASSWORD and STASH_WEB_SESSION_SECRET empty to run the daemon
# Telegram-only (no web UI). Set both to turn the web UI on.
# STASH_WEB_SESSION_SECRET signs your login session; keep it stable (rotating it
# logs you out) and secret. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STASH_WEB_BIND=127.0.0.1
STASH_WEB_PORT=8000
STASH_WEB_PASSWORD=
STASH_WEB_SESSION_SECRET=
# STASH_WEB_BIND=127.0.0.1 keeps the UI on this machine only. Binding to
# 0.0.0.0 exposes it to your network and MUST be fronted by TLS (see
# docs/guides/web-setup.md); the bind address alone does not make it "LAN only".

# --- Telegram (optional channel) ---
STASH_TELEGRAM_BOT_TOKEN=
STASH_ALLOWED_SENDER_IDS=

# --- Reminder scheduler ---
STASH_SCHEDULER_TICK_SECONDS=30
STASH_REMINDER_LEASE_SECONDS=120
STASH_REMINDER_MAX_ATTEMPTS=5
STASH_BUSY_TIMEOUT_MS=5000
